PORT=3000

# Supabase Connection Info (Required)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: The service_role key must NEVER be exposed to the frontend.
# The backend uses this for trusted administrative tasks (e.g., verifying doctors)
# and generating AI summaries.

# AI Provider Info (Optional)
OPENAI_API_KEY=your-openai-api-key-here
